# Database Connection
# Ensure this points to your development PostGIS-enabled PostgreSQL instance.
# DO NOT place production credentials here.
DATABASE_URL="postgresql://username:password@localhost:5432/delivery_tracker_dev"

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication (JWT)
# Use a strong, random 32+ character string in production.
JWT_SECRET="replace_me_with_a_strong_secret_key"
JWT_EXPIRES_IN=24h

# CORS & Frontend URLs
FRONTEND_URL="http://localhost:5173"

# Third-Party API Keys (Placeholders)
EMAIL_SERVICE_API_KEY="your_email_api_key_here"
SMS_SERVICE_API_KEY="your_sms_api_key_here"
